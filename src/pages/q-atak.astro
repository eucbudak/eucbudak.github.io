---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTABand from '../components/CTABand.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import {
  konular,
  DERS_SIRASI,
  KRITICITE_LABEL,
  KRITICITE_COLOR,
  type Kriticite,
} from '../data/qAtakKonular';

// 11–15 Mayıs 2026 ders programı.
// Her hücre: { ders, konu }. Konular Excel'deki AYT 4-yıl soru analizinde en yüksek
// frekansa sahip "çok kritik" başlıklardan seçildi.
const saatler = [
  '09:00 – 10:30',
  '10:45 – 12:15',
  '13:30 – 15:00',
  '15:15 – 16:45',
  '17:00 – 18:30',
];

const program: Array<{ gun: string; tarih: string; bloklar: Array<{ ders: string; konu: string }> }> = [
  {
    gun: 'Pazartesi',
    tarih: '11 Mayıs',
    bloklar: [
      { ders: 'Matematik', konu: 'Türevin Kavramı' },
      { ders: 'Geometri',  konu: 'Çemberin Temel Elemanları' },
      { ders: 'Fizik',     konu: 'Manyetik Akı ve İndüksiyon' },
      { ders: 'Kimya',     konu: 'Esterler' },
      { ders: 'Biyoloji',  konu: 'Bitki Fizyolojisi' },
    ],
  },
  {
    gun: 'Salı',
    tarih: '12 Mayıs',
    bloklar: [
      { ders: 'Matematik', konu: 'İki Kat (Yarım) Açı Formülleri' },
      { ders: 'Geometri',  konu: 'Piramitler' },
      { ders: 'Fizik',     konu: 'Düzgün Çembersel Hareket' },
      { ders: 'Kimya',     konu: 'Alkenler (Olefinler)' },
      { ders: 'Biyoloji',  konu: 'Nükleik Asitler & Kalıtım' },
    ],
  },
  {
    gun: 'Çarşamba',
    tarih: '13 Mayıs',
    bloklar: [
      { ders: 'Matematik', konu: 'Belirli İntegral' },
      { ders: 'Geometri',  konu: 'Çemberde Uzunluk' },
      { ders: 'Fizik',     konu: 'Tork (Moment) ve Denge' },
      { ders: 'Kimya',     konu: 'Elektrot Potansiyelleri' },
      { ders: 'Biyoloji',  konu: 'Oksijenli Solunum' },
    ],
  },
  {
    gun: 'Perşembe',
    tarih: '14 Mayıs',
    bloklar: [
      { ders: 'Matematik', konu: 'Logaritmalı Eşitsizlikler' },
      { ders: 'Geometri',  konu: 'Dairede Alan' },
      { ders: 'Fizik',     konu: 'Akım Geçen Tele Manyetik Kuvvet' },
      { ders: 'Kimya',     konu: 'Atom Modelleri' },
      { ders: 'Biyoloji',  konu: 'Sindirim Sistemi' },
    ],
  },
  {
    gun: 'Cuma',
    tarih: '15 Mayıs',
    bloklar: [
      { ders: 'Matematik', konu: 'Maksimum-Minimum Problemleri' },
      { ders: 'Geometri',  konu: 'Doğru Denklemleri' },
      { ders: 'Fizik',     konu: 'Sığa (Kapasite)' },
      { ders: 'Kimya',     konu: 'Çözeltilerin Özellikleri' },
      { ders: 'Biyoloji',  konu: 'Lenf & Bağışıklık Sistemi' },
    ],
  },
];

const dersRenk: Record<string, string> = {
  'Matematik': 'text-[#FF6B1A]',
  'Geometri':  'text-violet-400',
  'Fizik':     'text-sky-400',
  'Kimya':     'text-emerald-400',
  'Biyoloji':  'text-rose-400',
};

const dersIcon: Record<string, string> = {
  'AYT Matematik': '∑',
  'AYT Geometri':  '△',
  'AYT Fizik':     '⚛',
  'AYT Kimya':     '⚗',
  'AYT Biyoloji':  '🧬',
};

// Master konu listesi — yalnız sayısal dersler (DERS_SIRASI) ve yalnız
// "en-cok / cok-kritik / kritik" kriticite seviyeleri.
const SHOW_KRIT: Kriticite[] = ['en-cok', 'cok-kritik', 'kritik'];

const masterByDers = DERS_SIRASI.map(ders => {
  const list = konular
    .filter(k => k.ders === ders && SHOW_KRIT.includes(k.kriticite))
    .sort((a, b) => b.soru4Yil - a.soru4Yil);
  const total4Yil = list.reduce((sum, k) => sum + k.soru4Yil, 0);
  return { ders, list, total4Yil };
});

const toplamKonu = masterByDers.reduce((sum, d) => sum + d.list.length, 0);
const toplamSoru = masterByDers.reduce((sum, d) => sum + d.total4Yil, 0);
---

<Base
  title="Q ATAK KAMPI — Son 1 Ay Yoğun Hazırlık | KNT Akademi"
  description="YKS'ye 1 ay kala matematik, geometri, fizik, kimya ve biyolojiden en çok hata yapılan ve en çok soru çıkan kritik konulara odaklı 5 günlük yoğun kamp. 11–15 Mayıs 2026."
>

  <!-- HERO -->
  <section class="pt-32 md:pt-40 pb-16 bg-ink text-white relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 20% 0%, rgba(255,107,26,0.18) 0%, transparent 55%), radial-gradient(ellipse at 80% 100%, rgba(255,26,78,0.12) 0%, transparent 50%);">
    </div>
    <div class="relative max-w-6xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-[#FF6B1A] uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-[#FF6B1A] animate-pulse"></span>
          Son 1 ay · 11–15 Mayıs 2026
        </span>
        <h1 class="text-5xl md:text-7xl font-black leading-none mb-6" style="letter-spacing:-0.03em">
          Q ATAK<br />KAMPI
        </h1>
        <p class="text-lg md:text-xl text-white/70 leading-relaxed mb-10 max-w-2xl">
          Bugüne kadar yaptığın denemelerdeki <strong class="text-white">eksiklere</strong> ve sınavda <strong class="text-white">en çok soru çıkan başlıklara</strong> odaklanan 5 günlük yoğun bir kamp. Matematik, geometri, fizik, kimya ve biyolojinin kritik konularına son atak.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <WhatsAppButton ctx="q-atak" label="Kayıt için WhatsApp" class="text-base px-7 py-3.5" />
          <a href="#program" class="inline-flex items-center gap-2 text-base font-semibold text-white/70 hover:text-white transition-colors py-3.5">
            Programı Gör
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19,12 12,19 5,12"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- ONE-PAGER -->
  <section class="py-24 md:py-28">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

        <div class="reveal">
          <SectionHeader
            eyebrow="Q ATAK KAMPI nedir?"
            title="Son 1 ayı en çok kayba uğradığın yere ayır."
          />
          <div class="mt-6 flex flex-col gap-5 text-muted leading-relaxed">
            <p>
              Sınava 1 ay kala her dakika eşit değerli değildir. Hâlâ hata yaptığın ve sınavda en çok soru çıkan konular, son 30 günün net farkını yaratacak yer.
            </p>
            <p>
              Q ATAK KAMPI, KNT Akademi koçlarının <strong class="text-ink">son 4 yılın AYT sorularını analiz</strong> edip belirlediği <strong class="text-ink">{toplamKonu} kritik başlığı</strong> 5 güne sıkıştıran yoğun bir hazırlık programıdır. Her gün matematik, geometri, fizik, kimya ve biyolojiden en çok soru çıkan ve en çok hata yapılan konuları işleriz.
            </p>
            <p>
              Hedef tek bir şey: sınavda <strong class="text-ink">net kaybetmediğin bir 1 ay</strong>. Konu anlatımı + bol soru çözümü + koçluk takibi.
            </p>
          </div>
        </div>

        <div class="reveal" style="transition-delay:100ms">
          <div class="grid grid-cols-2 gap-4">
            {[
              { num: '5',                    label: 'Gün',          desc: '11–15 Mayıs 2026' },
              { num: '5',                    label: 'Ders',         desc: 'MAT · GEO · FİZ · KİM · BİY' },
              { num: String(toplamKonu),     label: 'Kritik konu',  desc: 'Çok kritik + kritik' },
              { num: String(toplamSoru) + '+', label: 'AYT sorusu', desc: 'Son 4 yılda işlenen' },
            ].map(item => (
              <div class="bg-surface rounded-2xl border border-border p-6">
                <p class="text-3xl md:text-4xl font-black text-accent mb-2" style="letter-spacing:-0.02em">{item.num}</p>
                <p class="font-bold text-ink text-sm mb-1">{item.label}</p>
                <p class="text-xs text-muted leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>

          <div class="mt-6 rounded-2xl border-2 border-dashed border-[#FF6B1A]/40 bg-[#FF6B1A]/5 p-6">
            <p class="text-xs font-bold tracking-widest text-[#FF6B1A] uppercase mb-2">Kimler için?</p>
            <ul class="flex flex-col gap-2 text-sm text-muted leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Denemelerde aynı konuda tekrar hata yapanlar</li>
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Son 1 ayı plansız bırakmak istemeyenler</li>
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Sayısal derslerde net farkını sınav öncesi yapmak isteyenler</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- PROGRAM: 11–15 Mayıs ders saatleri -->
  <section id="program" class="py-24 md:py-28 bg-surface border-y border-border scroll-mt-40">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="reveal mb-12">
        <SectionHeader
          eyebrow="Ders Programı"
          title="11–15 Mayıs 2026"
          sub="Her gün 5 ders. Sabah konu anlatımı, öğleden sonra soru çözümü ve hata analizi. Saatler örnek olarak verilmiştir; kesin saatler ve derslikler kayıt sonrası iletilir."
        />
      </div>

      <!-- DESKTOP -->
      <div class="reveal hidden md:block overflow-x-auto rounded-2xl border border-border bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-ink text-white">
              <th class="text-left font-semibold px-5 py-4 w-44">Saat</th>
              {program.map(g => (
                <th class="text-left font-semibold px-5 py-4">
                  <div class="flex flex-col">
                    <span class="text-xs font-medium tracking-widest text-[#FF6B1A] uppercase">{g.tarih}</span>
                    <span>{g.gun}</span>
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {saatler.map((saat, i) => (
              <tr class="border-t border-border">
                <td class="px-5 py-5 font-semibold text-ink whitespace-nowrap align-top">{saat}</td>
                {program.map(g => (
                  <td class="px-5 py-5 align-top">
                    <span class={`block text-xs font-bold tracking-widest uppercase mb-1 ${dersRenk[g.bloklar[i].ders] ?? 'text-accent'}`}>
                      {g.bloklar[i].ders}
                    </span>
                    <span class="block text-sm text-ink leading-snug">{g.bloklar[i].konu}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- MOBILE -->
      <div class="md:hidden flex flex-col gap-4">
        {program.map(g => (
          <div class="reveal rounded-2xl border border-border bg-white overflow-hidden">
            <div class="bg-ink text-white px-5 py-4">
              <span class="text-xs font-bold tracking-widest text-[#FF6B1A] uppercase">{g.tarih}</span>
              <p class="text-lg font-bold">{g.gun}</p>
            </div>
            <div class="divide-y divide-border">
              {g.bloklar.map((b, i) => (
                <div class="px-5 py-4 flex flex-col gap-1">
                  <div class="flex items-center justify-between gap-3">
                    <span class={`text-xs font-bold tracking-widest uppercase ${dersRenk[b.ders] ?? 'text-accent'}`}>{b.ders}</span>
                    <span class="text-xs text-muted whitespace-nowrap">{saatler[i]}</span>
                  </div>
                  <p class="text-sm text-ink leading-snug">{b.konu}</p>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <p class="text-xs text-muted mt-6 text-center max-w-2xl mx-auto leading-relaxed">
        * Konu seçimleri KNT Akademi koçlarının son 4 yılın AYT sorularını analiziyle yapıldı. Tam liste aşağıda.
      </p>
    </div>
  </section>


  <!-- MASTER KONU LİSTESİ -->
  <section id="konu-listesi" class="py-24 md:py-28 scroll-mt-40">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="reveal mb-12">
        <SectionHeader
          eyebrow="Kritik Konu Master Listesi"
          title="Son 4 yılın sorularını analiz ettik."
          sub="Aşağıdaki liste, 2021–2024 AYT sınavlarında çıkan soruları KNT Akademi koçlarının analiziyle elde edildi. Yalnız çok kritik ve kritik seviyedeki başlıklar gösterildi. Sayılar, son 4 yılda o konudan çıkan toplam soru sayısıdır."
        />
        <!-- Lejant -->
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs">
          <span class="text-muted font-medium">Kritisite:</span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold bg-red-600 text-white">
            <span class="w-1.5 h-1.5 rounded-full bg-white"></span>En Çok Çıkan
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold bg-red-500/15 text-red-700 ring-1 ring-red-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Çok Kritik
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold bg-emerald-500/15 text-emerald-700 ring-1 ring-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Kritik
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {masterByDers.map((grup, gi) => (
          <div class="reveal rounded-2xl border border-border bg-white overflow-hidden flex flex-col" style={`transition-delay:${gi * 60}ms`}>
            <!-- Ders başlığı -->
            <div class="bg-ink text-white px-6 py-5 flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/10 text-2xl text-[#FF6B1A]" aria-hidden="true">
                  {dersIcon[grup.ders] ?? '◆'}
                </span>
                <div>
                  <p class="text-xs font-medium tracking-widest text-[#FF6B1A] uppercase">{grup.ders.replace('AYT ', '')}</p>
                  <p class="text-base font-bold">{grup.list.length} kritik konu</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-2xl font-black leading-none" style="letter-spacing:-0.02em">{grup.total4Yil}</p>
                <p class="text-[10px] uppercase tracking-widest text-white/50 mt-1">4 yıl<br />soru</p>
              </div>
            </div>

            <!-- Konu listesi -->
            <ul class="flex flex-col divide-y divide-border">
              {grup.list.map((k, i) => (
                <li class="px-6 py-4 flex items-start gap-4 hover:bg-surface/60 transition-colors">
                  <span class="text-xs font-bold text-muted/60 tabular-nums w-6 shrink-0 pt-1">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-3 mb-1">
                      <p class="text-sm font-semibold text-ink leading-snug">{k.konu}</p>
                      <span class={`shrink-0 inline-flex items-center justify-center min-w-[2.25rem] h-7 px-2 rounded-full text-xs font-bold ${KRITICITE_COLOR[k.kriticite]}`}>
                        {k.soru4Yil}
                      </span>
                    </div>
                    <div class="flex items-start gap-2 mt-1.5">
                      <span class={`shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${KRITICITE_COLOR[k.kriticite]}`}>
                        {KRITICITE_LABEL[k.kriticite]}
                      </span>
                      <p class="text-xs text-muted leading-relaxed">{k.detay}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="text-xs text-muted mt-8 text-center max-w-2xl mx-auto leading-relaxed">
        Toplam {toplamKonu} kritik başlık · {toplamSoru} AYT sorusu (2021–2024). Orta ve nadir başlıklar listede gösterilmemiştir.
      </p>
    </div>
  </section>


  <!-- CTA -->
  <CTABand
    title="Son 1 ay. Boşa harcama."
    sub="Q ATAK KAMPI'na kayıt ol — koçunla beraber gir."
    ctx="q-atak"
    label="WhatsApp ile kayıt"
  />
</Base>

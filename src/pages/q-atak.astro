---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  efelerProgrami,
  nazilliProgrami,
  SUBE_BILGI,
  type Program,
} from '../data/qAtakProgramlari';

// Sınav rozeti renkleri (TYT/AYT)
const sinavRozet: Record<'TYT' | 'AYT', string> = {
  AYT: 'bg-[#FF6B1A]/15 text-[#FF6B1A] ring-1 ring-[#FF6B1A]/30',
  TYT: 'bg-sky-500/15 text-sky-600 ring-1 ring-sky-500/30',
};

// Ders renk paleti (program tablosunda küçük etiket için)
const dersRenk: Record<string, string> = {
  'Matematik': 'text-[#FF6B1A]',
  'Fizik':     'text-sky-500',
  'Kimya':     'text-emerald-500',
  'Biyoloji':  'text-rose-500',
  'Türkçe':    'text-violet-500',
};

const programlar: Program[] = [efelerProgrami, nazilliProgrami];
---

<Base
  title="Q ATAK KAMPI — TYT + AYT Son 1 Ay Yoğun Hazırlık | KNT Akademi"
  description="YKS'ye 1 ay kala matematik, geometri, fizik, kimya, biyolojiden TYT ve AYT'nin en kritik konularına odaklı 10 günlük yoğun kamp. 11–22 Mayıs 2026, Efeler ve Nazilli şubelerinde."
>

  <!-- HERO -->
  <section class="pt-32 md:pt-40 pb-16 bg-ink text-white relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 20% 0%, rgba(255,107,26,0.18) 0%, transparent 55%), radial-gradient(ellipse at 80% 100%, rgba(56,189,248,0.12) 0%, transparent 50%);">
    </div>
    <div class="relative max-w-6xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-[#FF6B1A] uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-[#FF6B1A] animate-pulse"></span>
          11 Mayıs – 5 Haziran 2026 · 3 hafta · 15 gün
        </span>
        <h1 class="text-5xl md:text-7xl font-black leading-none mb-6" style="letter-spacing:-0.03em">
          Q ATAK<br />KAMPI
        </h1>
        <p class="text-lg md:text-xl text-white/70 leading-relaxed mb-6 max-w-2xl">
          Son 4 yılın TYT ve AYT sorularını <strong class="text-white">tek tek analiz ettik.</strong> Hangi konudan kaç soru çıktığını, hangi başlıklarda öğrencilerin en çok hata yaptığını çıkardık. Q ATAK KAMPI, bu analizden çıkan <strong class="text-[#FF6B1A]">en kritik başlıkları</strong> son 10 güne sığdıran yoğun bir hazırlık programıdır.
        </p>
        <p class="text-base md:text-lg text-white/55 leading-relaxed mb-10 max-w-2xl">
          Tahmin değil — <strong class="text-white">veri.</strong> Sınava 1 ay kala her dakikayı en çok kayba uğradığın yere ayır.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a href="#program" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#FF6B1A] hover:bg-[#FF8540] text-ink text-base font-semibold transition-colors">
            Programı Gör
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19,12 12,19 5,12"/>
            </svg>
          </a>
        </div>

        <!-- Analiz vurgusu — sayilarla ciddi calisma kanitlari -->
        <div class="mt-12 grid grid-cols-3 gap-4 md:gap-8 max-w-2xl border-t border-white/10 pt-8">
          <div>
            <p class="text-3xl md:text-4xl font-black text-[#FF6B1A]" style="letter-spacing:-0.02em">4 yıl</p>
            <p class="text-xs md:text-sm text-white/50 mt-1 leading-snug">2021–2024 ÖSYM soruları taranıp incelendi</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-black text-sky-400" style="letter-spacing:-0.02em">186</p>
            <p class="text-xs md:text-sm text-white/50 mt-1 leading-snug">Konu başlığı kritisite + frekansa göre puanlandı</p>
          </div>
          <div>
            <p class="text-3xl md:text-4xl font-black text-white" style="letter-spacing:-0.02em">3 hafta</p>
            <p class="text-xs md:text-sm text-white/50 mt-1 leading-snug">15 gün yoğun kamp — TYT + AYT alterne</p>
          </div>
        </div>

        <!-- Şube rozetleri -->
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <span class="text-xs font-medium text-white/40 tracking-widest uppercase">Şubeler:</span>
          {programlar.map(p => (
            <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 ring-1 ring-white/10 text-sm font-semibold ${SUBE_BILGI[p.sube].renk}`}>
              <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
              {SUBE_BILGI[p.sube].ad}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ONE-PAGER -->
  <section class="py-24 md:py-28">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

        <div class="reveal">
          <SectionHeader
            eyebrow="4 yıllık veri analizi"
            title="Tahmin etmiyoruz — ölçtük."
          />
          <div class="mt-6 flex flex-col gap-5 text-muted leading-relaxed">
            <p>
              KNT Akademi koçluk ekibi, <strong class="text-ink">2021–2024 yıllarında çıkmış tüm TYT ve AYT sorularını</strong> başlık başlık taradı; her bir konunun frekansını, kritisitesini ve mezunlarımızın anket başarı oranlarını çıkardı.
            </p>
            <p>
              Bu çalışma sonucunda <strong class="text-ink">186 başlık</strong> elendi, sıralandı ve "çok kritik / kritik" kategorilerine ayrıldı. Q ATAK KAMPI, bu listenin <strong class="text-ink">en yüksek puanlı başlıklarını</strong> son 10 güne sığdıran ölçülmüş bir hazırlık planıdır.
            </p>
            <p>
              Hedef tek bir şey: sınavda <strong class="text-ink">net kaybetmediğin bir 1 ay</strong>. Konu anlatımı + bol soru çözümü + koçluk takibi.
            </p>
          </div>
        </div>

        <div class="reveal" style="transition-delay:100ms">
          <div class="grid grid-cols-2 gap-4">
            {[
              { num: '4',     label: 'Yıl',          desc: '2021–2024 ÖSYM soruları analizi' },
              { num: '186',   label: 'Başlık',       desc: 'Frekans + kritisite puanlandı' },
              { num: '15',    label: 'Gün',          desc: '11 Mayıs – 5 Haziran · 3 hafta' },
              { num: '4+1',   label: 'Ders',         desc: 'MAT · FİZ · KİM · BİY · TÜR' },
            ].map(item => (
              <div class="bg-surface rounded-2xl border border-border p-6">
                <p class="text-3xl md:text-4xl font-black text-accent mb-2" style="letter-spacing:-0.02em">{item.num}</p>
                <p class="font-bold text-ink text-sm mb-1">{item.label}</p>
                <p class="text-xs text-muted leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>

          <div class="mt-6 rounded-2xl border-2 border-dashed border-[#FF6B1A]/40 bg-[#FF6B1A]/5 p-6">
            <p class="text-xs font-bold tracking-widest text-[#FF6B1A] uppercase mb-2">Kimler için?</p>
            <ul class="flex flex-col gap-2 text-sm text-muted leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Denemelerde aynı konuda tekrar hata yapanlar</li>
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Son 1 ayı plansız bırakmak istemeyenler</li>
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Sayısal derslerde net farkını sınav öncesi yapmak isteyenler</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- PROGRAM: Yan yana iki şube -->
  <section id="program" class="py-24 md:py-28 bg-surface border-y border-border scroll-mt-40">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="reveal mb-12 max-w-3xl">
        <SectionHeader
          eyebrow="Şubelerin Programı"
          title="11 Mayıs – 5 Haziran 2026"
        />
        <!-- Sınav rozeti lejantı -->
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs">
          <span class="text-muted font-medium">Etiketler:</span>
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold ${sinavRozet.AYT}`}>
            <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B1A]"></span>AYT
          </span>
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold ${sinavRozet.TYT}`}>
            <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>TYT
          </span>
        </div>
      </div>

      <!-- Yan yana 2 sütun (md+), tek kolon (mobile) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {programlar.map((p, pi) => {
          const hafta1 = p.gunler.filter(g => g.hafta === 1);
          const hafta2 = p.gunler.filter(g => g.hafta === 2);
          const hafta3 = p.gunler.filter(g => g.hafta === 3);
          const subeBilgi = SUBE_BILGI[p.sube];
          return (
            <div class="reveal flex flex-col rounded-2xl border border-border bg-white overflow-hidden" style={`transition-delay:${pi * 80}ms`}>
              <!-- Şube başlığı -->
              <div class="bg-ink text-white px-6 py-5 flex items-start justify-between gap-4">
                <div>
                  <p class={`text-xs font-bold tracking-widest uppercase ${subeBilgi.renk}`}>
                    {subeBilgi.konum}
                  </p>
                  <h3 class="text-xl md:text-2xl font-bold mt-1" style="letter-spacing:-0.02em">{p.baslik}</h3>
                </div>
                <span class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/5 ring-1 ring-white/10 text-xl font-black" aria-hidden="true">
                  {p.sube === 'efeler' ? 'E' : 'N'}
                </span>
              </div>

              <!-- Haftalar -->
              {[
                { no: 1, etiket: 'Hafta 1 · 11–15 Mayıs', gunler: hafta1 },
                { no: 2, etiket: 'Hafta 2 · 18–22 Mayıs', gunler: hafta2 },
                { no: 3, etiket: 'Hafta 3 · 1–5 Haziran · sadece Matematik', gunler: hafta3 },
              ].map((h, hi) => (
                <div>
                  <div class={`px-6 py-3 ${hi === 0 ? '' : 'border-t border-border'} bg-surface/60`}>
                    <p class="text-xs font-bold tracking-widest text-muted uppercase">{h.etiket}</p>
                  </div>
                  <ul class="divide-y divide-border">
                    {h.gunler.map(g => (
                      <li class={g.tatil ? 'bg-red-50/40' : ''}>
                        <div class="px-6 pt-4 pb-2 flex items-baseline justify-between gap-3">
                          <span class="text-sm font-bold text-ink">{g.gun}</span>
                          <span class="text-xs font-medium tracking-widest text-[#FF6B1A] uppercase">{g.tarih}</span>
                        </div>
                        {g.tatil ? (
                          <div class="mx-6 mb-4 rounded-xl border-2 border-red-300 bg-red-50 px-4 py-3 flex items-start gap-3">
                            <span class="text-lg leading-none mt-0.5" aria-hidden="true">🇹🇷</span>
                            <div class="min-w-0 flex-1">
                              <p class="text-xs font-bold tracking-widest text-red-700 uppercase">Resmi Tatil</p>
                              <p class="text-sm text-red-900 leading-snug mt-0.5">{g.tatil}</p>
                              <p class="text-xs text-red-700/70 mt-1">Bu gün ders yapılmayacak.</p>
                            </div>
                          </div>
                        ) : (
                        <div class="px-6 pb-3 flex flex-col gap-1.5">
                          {g.saatler.map(s => (
                            s.ders ? (
                              s.isFirst ? (
                                <div class="flex items-start gap-3 text-sm">
                                  <span class="text-[11px] font-mono text-muted whitespace-nowrap shrink-0 pt-0.5 w-24">{s.saat}</span>
                                  <span class={`shrink-0 inline-flex items-center justify-center px-1.5 py-0.5 rounded text-[10px] font-bold ${sinavRozet[s.sinav!]}`}>
                                    {s.sinav}
                                  </span>
                                  <div class="min-w-0 flex-1">
                                    <span class={`block text-[11px] font-bold tracking-widest uppercase leading-tight ${dersRenk[s.ders] ?? 'text-accent'}`}>
                                      {s.ders}
                                    </span>
                                    <span class="block text-sm text-ink leading-snug">{s.konu}</span>
                                  </div>
                                </div>
                              ) : (
                                <div class="flex items-center gap-3 text-sm">
                                  <span class="text-[11px] font-mono text-muted whitespace-nowrap shrink-0 pt-0.5 w-24">{s.saat}</span>
                                  <span class="text-[10px] uppercase tracking-widest text-muted/60 italic shrink-0">↳ devam</span>
                                  <span class={`text-[11px] font-bold tracking-widest uppercase opacity-60 ${dersRenk[s.ders] ?? 'text-accent'}`}>
                                    {s.ders}
                                  </span>
                                </div>
                              )
                            ) : (
                              <div class="flex items-center gap-3 text-sm opacity-40">
                                <span class="text-[11px] font-mono whitespace-nowrap shrink-0 w-24">{s.saat}</span>
                                <span class="text-xs italic text-muted">— ders yok —</span>
                              </div>
                            )
                          ))}
                        </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          );
        })}
      </div>

      <p class="text-xs text-muted mt-6 text-center max-w-3xl mx-auto leading-relaxed">
        * Her ders tek saat slotunda, AYT ve TYT konuları gün gün alterne işlenir. Hafta 3 (1–5 Haziran) artakalan Matematik konuları için ek hafta. Boş slotlar o gün ilgili dersin olmadığı saatlerdir.
      </p>
    </div>
  </section>



  <!-- KAPANIŞ -->
  <section class="bg-ink text-white py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 50% 100%, rgba(255,107,26,0.15) 0%, transparent 60%);">
    </div>
    <div class="relative max-w-3xl mx-auto px-6 md:px-8 text-center flex flex-col items-center gap-6">
      <span class="text-xs font-bold tracking-widest text-[#FF6B1A] uppercase">11–22 Mayıs 2026</span>
      <h2 class="text-3xl md:text-5xl font-bold leading-tight" style="letter-spacing:-0.03em">
        Son 1 ay. Boşa harcama.
      </h2>
      <p class="text-base md:text-lg text-white/60 leading-relaxed max-w-xl">
        Q ATAK KAMPI Efeler ve Nazilli şubelerinde başlıyor. Detaylar için kendi şubene danış.
      </p>
    </div>
  </section>
</Base>

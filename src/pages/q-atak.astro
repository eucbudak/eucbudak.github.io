---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import {
  konular,
  DERS_SIRASI_AYT,
  DERS_SIRASI_TYT,
  KRITICITE_LABEL,
  KRITICITE_COLOR,
  type Kriticite,
  type Sinav,
} from '../data/qAtakKonular';
import {
  efelerProgrami,
  nazilliProgrami,
  SUBE_BILGI,
  type Program,
} from '../data/qAtakProgramlari';

// Sınav rozeti renkleri (TYT/AYT)
const sinavRozet: Record<Sinav, string> = {
  AYT: 'bg-[#FF6B1A]/15 text-[#FF6B1A] ring-1 ring-[#FF6B1A]/30',
  TYT: 'bg-sky-500/15 text-sky-600 ring-1 ring-sky-500/30',
};

// Ders renk paleti (program tablosunda küçük etiket için)
const dersRenk: Record<string, string> = {
  'Matematik': 'text-[#FF6B1A]',
  'Fizik':     'text-sky-500',
  'Kimya':     'text-emerald-500',
  'Biyoloji':  'text-rose-500',
  'Türkçe':    'text-violet-500',
};

// Ders ikonları (master liste başlığında)
const dersIcon: Record<string, string> = {
  'AYT Matematik': '∑', 'AYT Geometri': '△', 'AYT Fizik': '⚛', 'AYT Kimya': '⚗', 'AYT Biyoloji': '🧬',
  'TYT Matematik': '∑', 'TYT Geometri': '△', 'TYT Fizik': '⚛', 'TYT Kimya': '⚗', 'TYT Biyoloji': '🧬',
};

// Master listede yalnız çok-kritik + kritik (orta + nadir filtrelenir)
const SHOW_KRIT: Kriticite[] = ['en-cok', 'cok-kritik', 'kritik'];

function buildMaster(dersListesi: string[]) {
  return dersListesi.map(ders => {
    const list = konular
      .filter(k => k.ders === ders && SHOW_KRIT.includes(k.kriticite))
      .sort((a, b) => b.soru4Yil - a.soru4Yil);
    const total4Yil = list.reduce((sum, k) => sum + k.soru4Yil, 0);
    return { ders, list, total4Yil };
  });
}

const masterAyt = buildMaster(DERS_SIRASI_AYT);
const masterTyt = buildMaster(DERS_SIRASI_TYT);

const aytKonu = masterAyt.reduce((s, d) => s + d.list.length, 0);
const tytKonu = masterTyt.reduce((s, d) => s + d.list.length, 0);
const aytSoru = masterAyt.reduce((s, d) => s + d.total4Yil, 0);
const tytSoru = masterTyt.reduce((s, d) => s + d.total4Yil, 0);
const toplamKonu = aytKonu + tytKonu;
const toplamSoru = aytSoru + tytSoru;

const programlar: Program[] = [efelerProgrami, nazilliProgrami];
---

<Base
  title="Q ATAK KAMPI — TYT + AYT Son 1 Ay Yoğun Hazırlık | KNT Akademi"
  description="YKS'ye 1 ay kala matematik, geometri, fizik, kimya, biyolojiden TYT ve AYT'nin en kritik konularına odaklı 10 günlük yoğun kamp. 11–22 Mayıs 2026, Efeler ve Nazilli şubelerinde."
>

  <!-- HERO -->
  <section class="pt-32 md:pt-40 pb-16 bg-ink text-white relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 20% 0%, rgba(255,107,26,0.18) 0%, transparent 55%), radial-gradient(ellipse at 80% 100%, rgba(56,189,248,0.12) 0%, transparent 50%);">
    </div>
    <div class="relative max-w-6xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-[#FF6B1A] uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-[#FF6B1A] animate-pulse"></span>
          Son 1 ay · 11–22 Mayıs 2026 · 10 gün
        </span>
        <h1 class="text-5xl md:text-7xl font-black leading-none mb-6" style="letter-spacing:-0.03em">
          Q ATAK<br />KAMPI
        </h1>
        <p class="text-lg md:text-xl text-white/70 leading-relaxed mb-10 max-w-2xl">
          Bugüne kadar yaptığın denemelerdeki <strong class="text-white">eksiklere</strong> ve sınavda <strong class="text-white">en çok soru çıkan başlıklara</strong> odaklanan 10 günlük yoğun bir kamp. <strong class="text-[#FF6B1A]">AYT</strong> ve <strong class="text-sky-300">TYT</strong> sayısal derslerinin kritik konularına son atak.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a href="#program" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#FF6B1A] hover:bg-[#FF8540] text-ink text-base font-semibold transition-colors">
            Programı Gör
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19,12 12,19 5,12"/>
            </svg>
          </a>
          <a href="#konu-listesi" class="inline-flex items-center gap-2 text-base font-semibold text-white/70 hover:text-white transition-colors py-3.5">
            Kritik Konu Listesi
          </a>
        </div>

        <!-- Şube rozetleri -->
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <span class="text-xs font-medium text-white/40 tracking-widest uppercase">Şubeler:</span>
          {programlar.map(p => (
            <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 ring-1 ring-white/10 text-sm font-semibold ${SUBE_BILGI[p.sube].renk}`}>
              <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
              {SUBE_BILGI[p.sube].ad}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ONE-PAGER -->
  <section class="py-24 md:py-28">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

        <div class="reveal">
          <SectionHeader
            eyebrow="Q ATAK KAMPI nedir?"
            title="Son 1 ayı en çok kayba uğradığın yere ayır."
          />
          <div class="mt-6 flex flex-col gap-5 text-muted leading-relaxed">
            <p>
              Sınava 1 ay kala her dakika eşit değerli değildir. Hâlâ hata yaptığın ve sınavda en çok soru çıkan konular, son 30 günün net farkını yaratacak yer.
            </p>
            <p>
              Q ATAK KAMPI, KNT Akademi koçlarının <strong class="text-ink">son 4 yılın TYT ve AYT sorularını analiz</strong> edip belirlediği <strong class="text-ink">{toplamKonu} kritik başlığı</strong> 10 güne sıkıştıran yoğun bir hazırlık programıdır. Her gün matematik, geometri, fizik, kimya ve biyolojiden en çok soru çıkan ve en çok hata yapılan konuları işleriz.
            </p>
            <p>
              Hedef tek bir şey: sınavda <strong class="text-ink">net kaybetmediğin bir 1 ay</strong>. Konu anlatımı + bol soru çözümü + koçluk takibi.
            </p>
          </div>
        </div>

        <div class="reveal" style="transition-delay:100ms">
          <div class="grid grid-cols-2 gap-4">
            {[
              { num: '10',                    label: 'Gün',          desc: '11–22 Mayıs · 2 hafta' },
              { num: '4+1',                   label: 'Ders',         desc: 'MAT · FİZ · KİM · BİY · TÜR' },
              { num: String(toplamKonu),      label: 'Kritik konu',  desc: `${aytKonu} AYT · ${tytKonu} TYT` },
              { num: String(toplamSoru) + '+', label: 'YKS sorusu',  desc: 'Son 4 yılda işlenen' },
            ].map(item => (
              <div class="bg-surface rounded-2xl border border-border p-6">
                <p class="text-3xl md:text-4xl font-black text-accent mb-2" style="letter-spacing:-0.02em">{item.num}</p>
                <p class="font-bold text-ink text-sm mb-1">{item.label}</p>
                <p class="text-xs text-muted leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>

          <div class="mt-6 rounded-2xl border-2 border-dashed border-[#FF6B1A]/40 bg-[#FF6B1A]/5 p-6">
            <p class="text-xs font-bold tracking-widest text-[#FF6B1A] uppercase mb-2">Kimler için?</p>
            <ul class="flex flex-col gap-2 text-sm text-muted leading-relaxed">
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Denemelerde aynı konuda tekrar hata yapanlar</li>
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Son 1 ayı plansız bırakmak istemeyenler</li>
              <li class="flex items-start gap-2"><span class="text-[#FF6B1A] mt-0.5">→</span>Sayısal derslerde net farkını sınav öncesi yapmak isteyenler</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- PROGRAM: Yan yana iki şube -->
  <section id="program" class="py-24 md:py-28 bg-surface border-y border-border scroll-mt-40">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <div class="reveal mb-12 max-w-3xl">
        <SectionHeader
          eyebrow="Şubelerin Programı"
          title="11–22 Mayıs 2026"
          sub="İki şube, iki ayrı program. Her iki haftada da hem AYT hem TYT konuları işlenir (alterne). Sayısal dersler kendi sabit saatinde (13:10 Mat · 14:00 Fiz · 14:50 Kim · 15:40 Biy). Türkçe Excel'de dolu olan günlerde boş saat slotuna yerleştirilir; sayısal konu havuzunda yer kalmazsa Türkçe slotlarını da kullanabilir. Kesin saatler ve derslikler kayıt sonrası iletilir."
        />
        <!-- Sınav rozeti lejantı -->
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs">
          <span class="text-muted font-medium">Etiketler:</span>
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold ${sinavRozet.AYT}`}>
            <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B1A]"></span>AYT
          </span>
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold ${sinavRozet.TYT}`}>
            <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>TYT
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full font-medium text-muted ring-1 ring-border">
            ×N = paralel sınıf sayısı
          </span>
        </div>
      </div>

      <!-- Yan yana 2 sütun (md+), tek kolon (mobile) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {programlar.map((p, pi) => {
          const hafta1 = p.gunler.filter(g => g.hafta === 1);
          const hafta2 = p.gunler.filter(g => g.hafta === 2);
          const subeBilgi = SUBE_BILGI[p.sube];
          return (
            <div class="reveal flex flex-col rounded-2xl border border-border bg-white overflow-hidden" style={`transition-delay:${pi * 80}ms`}>
              <!-- Şube başlığı -->
              <div class="bg-ink text-white px-6 py-5 flex items-start justify-between gap-4">
                <div>
                  <p class={`text-xs font-bold tracking-widest uppercase ${subeBilgi.renk}`}>
                    {subeBilgi.konum}
                  </p>
                  <h3 class="text-xl md:text-2xl font-bold mt-1" style="letter-spacing:-0.02em">{p.baslik}</h3>
                </div>
                <span class="shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/5 ring-1 ring-white/10 text-xl font-black" aria-hidden="true">
                  {p.sube === 'efeler' ? 'E' : 'N'}
                </span>
              </div>

              <!-- Haftalar -->
              {[
                { no: 1, etiket: 'Hafta 1 · 11–15 Mayıs', gunler: hafta1 },
                { no: 2, etiket: 'Hafta 2 · 18–22 Mayıs', gunler: hafta2 },
              ].map((h, hi) => (
                <div>
                  <div class={`px-6 py-3 ${hi === 0 ? '' : 'border-t border-border'} bg-surface/60`}>
                    <p class="text-xs font-bold tracking-widest text-muted uppercase">{h.etiket}</p>
                  </div>
                  <ul class="divide-y divide-border">
                    {h.gunler.map(g => (
                      <li>
                        <div class="px-6 pt-4 pb-2 flex items-baseline justify-between gap-3">
                          <span class="text-sm font-bold text-ink">{g.gun}</span>
                          <span class="text-xs font-medium tracking-widest text-[#FF6B1A] uppercase">{g.tarih}</span>
                        </div>
                        <div class="px-6 pb-3 flex flex-col gap-1.5">
                          {g.saatler.map(s => (
                            s.ders ? (
                              <div class="flex items-start gap-3 text-sm">
                                <span class="text-[11px] font-mono text-muted whitespace-nowrap shrink-0 pt-0.5 w-24">{s.saat}</span>
                                <span class={`shrink-0 inline-flex items-center justify-center px-1.5 py-0.5 rounded text-[10px] font-bold ${sinavRozet[s.sinav!]}`}>
                                  {s.sinav}
                                </span>
                                <div class="min-w-0 flex-1">
                                  <div class="flex items-baseline gap-2 leading-tight">
                                    <span class={`text-[11px] font-bold tracking-widest uppercase ${dersRenk[s.ders] ?? 'text-accent'}`}>
                                      {s.ders}
                                    </span>
                                    {s.kapasite && s.kapasite > 1 && (
                                      <span class="text-[10px] font-bold text-muted">×{s.kapasite}</span>
                                    )}
                                  </div>
                                  <span class="block text-sm text-ink leading-snug">{s.konu}</span>
                                </div>
                              </div>
                            ) : (
                              <div class="flex items-center gap-3 text-sm opacity-40">
                                <span class="text-[11px] font-mono whitespace-nowrap shrink-0 w-24">{s.saat}</span>
                                <span class="text-xs italic text-muted">— ders yok —</span>
                              </div>
                            )
                          ))}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          );
        })}
      </div>

      <p class="text-xs text-muted mt-6 text-center max-w-3xl mx-auto leading-relaxed">
        * Saat slotları sabit: 13:10 Matematik, 14:00 Fizik, 14:50 Kimya, 15:40 Biyoloji. Türkçe paralel olarak işlenir. Boş slotlar o gün ilgili dersin olmadığı saatlerdir.
      </p>
    </div>
  </section>


  <!-- MASTER KONU LİSTESİ -->
  <section id="konu-listesi" class="py-24 md:py-28 scroll-mt-40">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="reveal mb-12">
        <SectionHeader
          eyebrow="Kritik Konu Master Listesi"
          title="Son 4 yılın sorularını analiz ettik."
          sub="Aşağıdaki listeler, 2021–2024 TYT ve AYT sınavlarında çıkan soruları KNT Akademi koçlarının analiziyle elde edildi. Yalnız çok kritik ve kritik seviyedeki başlıklar gösterildi. Sayılar, son 4 yılda o konudan çıkan toplam soru sayısıdır."
        />
        <!-- Kriticite lejantı -->
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs">
          <span class="text-muted font-medium">Kritisite:</span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold bg-red-600 text-white">
            <span class="w-1.5 h-1.5 rounded-full bg-white"></span>En Çok Çıkan
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold bg-red-500/15 text-red-700 ring-1 ring-red-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Çok Kritik
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full font-bold bg-emerald-500/15 text-emerald-700 ring-1 ring-emerald-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Kritik
          </span>
        </div>
      </div>

      <!-- AYT bölümü -->
      <div class="reveal mb-8 flex items-baseline gap-3 border-b border-border pb-3">
        <span class={`inline-flex items-center justify-center px-3 py-1 rounded-full text-sm font-bold ${sinavRozet.AYT}`}>AYT</span>
        <h3 class="text-xl md:text-2xl font-bold text-ink" style="letter-spacing:-0.02em">Sayısal — {aytKonu} kritik konu</h3>
        <span class="text-sm text-muted ml-auto">{aytSoru} soru / 4 yıl</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-20">
        {masterAyt.map((grup, gi) => (
          <div class="reveal rounded-2xl border border-border bg-white overflow-hidden flex flex-col" style={`transition-delay:${gi * 60}ms`}>
            <div class="bg-ink text-white px-6 py-5 flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/10 text-2xl text-[#FF6B1A]" aria-hidden="true">
                  {dersIcon[grup.ders] ?? '◆'}
                </span>
                <div>
                  <p class="text-xs font-medium tracking-widest text-[#FF6B1A] uppercase">{grup.ders.replace('AYT ', '')}</p>
                  <p class="text-base font-bold">{grup.list.length} kritik konu</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-2xl font-black leading-none" style="letter-spacing:-0.02em">{grup.total4Yil}</p>
                <p class="text-[10px] uppercase tracking-widest text-white/50 mt-1">4 yıl<br />soru</p>
              </div>
            </div>
            <ul class="flex flex-col divide-y divide-border">
              {grup.list.map((k, i) => (
                <li class="px-6 py-4 flex items-start gap-4 hover:bg-surface/60 transition-colors">
                  <span class="text-xs font-bold text-muted/60 tabular-nums w-6 shrink-0 pt-1">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-3 mb-1">
                      <p class="text-sm font-semibold text-ink leading-snug">{k.konu}</p>
                      <span class={`shrink-0 inline-flex items-center justify-center min-w-[2.25rem] h-7 px-2 rounded-full text-xs font-bold ${KRITICITE_COLOR[k.kriticite]}`}>
                        {k.soru4Yil}
                      </span>
                    </div>
                    <div class="flex items-start gap-2 mt-1.5">
                      <span class={`shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${KRITICITE_COLOR[k.kriticite]}`}>
                        {KRITICITE_LABEL[k.kriticite]}
                      </span>
                      <p class="text-xs text-muted leading-relaxed">{k.detay}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- TYT bölümü -->
      <div class="reveal mb-8 flex items-baseline gap-3 border-b border-border pb-3">
        <span class={`inline-flex items-center justify-center px-3 py-1 rounded-full text-sm font-bold ${sinavRozet.TYT}`}>TYT</span>
        <h3 class="text-xl md:text-2xl font-bold text-ink" style="letter-spacing:-0.02em">Sayısal — {tytKonu} kritik konu</h3>
        <span class="text-sm text-muted ml-auto">{tytSoru} soru / 4 yıl</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {masterTyt.map((grup, gi) => (
          <div class="reveal rounded-2xl border border-border bg-white overflow-hidden flex flex-col" style={`transition-delay:${gi * 60}ms`}>
            <div class="bg-ink text-white px-6 py-5 flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/10 text-2xl text-sky-400" aria-hidden="true">
                  {dersIcon[grup.ders] ?? '◆'}
                </span>
                <div>
                  <p class="text-xs font-medium tracking-widest text-sky-400 uppercase">{grup.ders.replace('TYT ', '')}</p>
                  <p class="text-base font-bold">{grup.list.length} kritik konu</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-2xl font-black leading-none" style="letter-spacing:-0.02em">{grup.total4Yil}</p>
                <p class="text-[10px] uppercase tracking-widest text-white/50 mt-1">4 yıl<br />soru</p>
              </div>
            </div>
            <ul class="flex flex-col divide-y divide-border">
              {grup.list.map((k, i) => (
                <li class="px-6 py-4 flex items-start gap-4 hover:bg-surface/60 transition-colors">
                  <span class="text-xs font-bold text-muted/60 tabular-nums w-6 shrink-0 pt-1">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-3 mb-1">
                      <p class="text-sm font-semibold text-ink leading-snug">{k.konu}</p>
                      <span class={`shrink-0 inline-flex items-center justify-center min-w-[2.25rem] h-7 px-2 rounded-full text-xs font-bold ${KRITICITE_COLOR[k.kriticite]}`}>
                        {k.soru4Yil}
                      </span>
                    </div>
                    <div class="flex items-start gap-2 mt-1.5">
                      <span class={`shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${KRITICITE_COLOR[k.kriticite]}`}>
                        {KRITICITE_LABEL[k.kriticite]}
                      </span>
                      <p class="text-xs text-muted leading-relaxed">{k.detay}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="text-xs text-muted mt-8 text-center max-w-2xl mx-auto leading-relaxed">
        Toplam {toplamKonu} kritik başlık · {toplamSoru} YKS sorusu (2021–2024). Orta ve nadir başlıklar listede gösterilmemiştir.
      </p>
    </div>
  </section>


  <!-- KAPANIŞ -->
  <section class="bg-ink text-white py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"

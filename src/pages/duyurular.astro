---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const TEL_DISPLAY = '0532 131 44 09';
const TEL_HREF = 'tel:+905321314409';

// Ders dağılımı (toplam 24 saat/hafta)
const dersler = [
  { ad: 'Matematik', saat: 12, renk: 'bg-blue-600',    emoji: '➗' },
  { ad: 'Fizik',     saat: 4,  renk: 'bg-violet-500',  emoji: '⚛️' },
  { ad: 'Kimya',     saat: 4,  renk: 'bg-emerald-500', emoji: '🧪' },
  { ad: 'Biyoloji',  saat: 4,  renk: 'bg-rose-500',    emoji: '🧬' },
];

// Program takvimi
const donemler = [
  { aralik: '29 Haziran – 16 Temmuz', tip: 'DERS',  icon: '📖' },
  { aralik: '20 – 26 Temmuz',         tip: 'TATİL', icon: '🌴' },
  { aralik: '27 Temmuz – 14 Ağustos', tip: 'DERS',  icon: '📖' },
];

// Sınav takvimi
const sinavlar = [
  { gun: '28', ay: 'Haziran', ad: 'TYT Hazır Bulunuşluk Sınavı', saat: '16:00' },
  { gun: '17', ay: 'Temmuz',  ad: 'TYT KTS',                     saat: '16:00' },
  { gun: '13', ay: 'Ağustos', ad: 'TYT KTS',                     saat: '16:00' },
];

// Değerler
const degerler = [
  { ad: 'Disiplinli Çalışma', emoji: '👥' },
  { ad: 'Doğru Plan',         emoji: '🎯' },
  { ad: 'İstikrarlı Tekrar',  emoji: '📈' },
  { ad: 'Düzenli Sınav Takibi', emoji: '🏆' },
];

const gunler = ['Pazartesi', 'Salı', 'Çarşamba', 'Perşembe'];
---

<Base
  title="Duyurular — TYT Master Yaz Programı | KNT Akademi"
  description="TYT Master Yaz Programı KNT Akademi Efeler ve Nazilli'de başlıyor. 6 hafta, haftada 24 saat TYT odaklı hazırlık. 29 Haziran – 14 Ağustos 2026. Hemen ön kayıt oluşturun."
>

  <!-- HERO -->
  <section class="pt-32 md:pt-40 pb-16 bg-ink text-white relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 15% 0%, rgba(155,0,48,0.32) 0%, transparent 55%), radial-gradient(ellipse at 85% 100%, rgba(56,189,248,0.12) 0%, transparent 50%);">
    </div>
    <div class="relative max-w-6xl mx-auto px-6 md:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-accent uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          Duyurular · Yeni Program
        </span>
        <p class="text-sm font-bold tracking-[0.2em] text-white/60 uppercase mb-3">Hedefimiz net: TYT'de zirve!</p>
        <h1 class="text-5xl md:text-7xl font-black leading-none mb-5" style="letter-spacing:-0.03em">
          TYT Master<br /><span class="text-accent">Yaz Programı</span>
        </h1>
        <p class="text-lg md:text-xl text-white/75 leading-relaxed mb-8 max-w-xl">
          İşte başlıyoruz! TYT'ye en güçlü yaz başlangıcı — KNT Akademi <strong class="text-white">Efeler</strong> ve
          <strong class="text-white">Nazilli</strong> şubelerinde, 6 hafta boyunca yoğun ve TYT odaklı hazırlık.
        </p>

        <!-- Hızlı bilgiler -->
        <div class="flex flex-wrap gap-3 mb-9">
          {[
            { ust: '6', alt: 'Hafta', icon: '📅' },
            { ust: '24', alt: 'Saat / Hafta', icon: '⏱' },
            { ust: 'TYT', alt: 'Odaklı', icon: '🎯' },
          ].map(b => (
            <div class="inline-flex items-center gap-3 rounded-2xl bg-white/[0.06] ring-1 ring-white/10 px-5 py-3">
              <span class="text-xl" aria-hidden="true">{b.icon}</span>
              <span>
                <span class="block text-lg font-black leading-none text-white">{b.ust}</span>
                <span class="block text-[11px] font-medium tracking-wide uppercase text-white/55 mt-0.5">{b.alt}</span>
              </span>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row items-start gap-3">
          <WhatsAppButton ctx="tyt-master" label="Hemen Ön Kayıt Oluştur" class="text-base px-7 py-3.5" />
          <a href={TEL_HREF}
            class="inline-flex items-center gap-2.5 border border-white/25 hover:border-white/50 hover:bg-white/5 text-white font-semibold px-7 py-3.5 rounded-full transition-colors text-base">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.68 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.74-1.25a2 2 0 0 1 2.11-.45c.74.32 1.53.55 2.34.68A2 2 0 0 1 22 16.92z"/>
            </svg>
            {TEL_DISPLAY}
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- DERS SAATLERİ · DERS DAĞILIMI · PROGRAM DÖNEMLERİ -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="grid md:grid-cols-3 gap-6">

        <!-- Ders saatleri -->
        <div class="reveal rounded-3xl border border-border bg-surface p-7">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-9 h-9 rounded-xl bg-accent text-white flex items-center justify-center shrink-0" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12,7 12,12 16,14"/></svg>
            </span>
            <h3 class="text-lg font-black text-ink tracking-tight">Ders Saatleri</h3>
          </div>
          <div class="space-y-4">
            <div>
              <p class="text-xs font-semibold tracking-wide uppercase text-muted mb-1">Günlük ders başı</p>
              <p class="text-2xl font-black text-ink">10:00 – 15:40</p>
            </div>
            <div class="h-px bg-border"></div>
            <div>
              <p class="text-xs font-semibold tracking-wide uppercase text-muted mb-1">Soru çözüm</p>
              <p class="text-2xl font-black text-ink">15:50 – 17:20</p>
            </div>
          </div>
          <p class="text-xs text-muted leading-relaxed mt-5">
            Program haftada 4 gün (Pazartesi, Salı, Çarşamba, Perşembe) uygulanmaktadır.
          </p>
        </div>

        <!-- Ders dağılımı -->
        <div class="reveal rounded-3xl border border-border bg-surface p-7" style="transition-delay:80ms">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-9 h-9 rounded-xl bg-accent text-white flex items-center justify-center shrink-0" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </span>
            <h3 class="text-lg font-black text-ink tracking-tight">Ders Dağılımı</h3>
          </div>
          <ul class="space-y-2.5">
            {dersler.map(d => (
              <li class="flex items-center gap-3">
                <span class={`w-8 h-8 rounded-lg ${d.renk} text-white flex items-center justify-center text-sm shrink-0`} aria-hidden="true">{d.emoji}</span>
                <span class="font-bold text-ink flex-1">{d.ad}</span>
                <span class="text-sm font-black text-muted tabular-nums">{d.saat} saat</span>
              </li>
            ))}
          </ul>
          <div class="mt-5 rounded-xl bg-ink text-white text-center py-3">
            <span class="text-sm font-bold">Toplam: <span class="text-accent">24 saat / hafta</span></span>
          </div>
        </div>

        <!-- Program dönemleri -->
        <div class="reveal rounded-3xl border border-border bg-surface p-7" style="transition-delay:160ms">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-9 h-9 rounded-xl bg-accent text-white flex items-center justify-center shrink-0" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </span>
            <h3 class="text-lg font-black text-ink tracking-tight">Program Dönemleri</h3>
          </div>
          <ul class="space-y-3">
            {donemler.map(d => (
              <li class="flex items-center gap-3">
                <span class="text-xl" aria-hidden="true">{d.icon}</span>
                <div>
                  <p class="text-sm font-bold text-ink leading-tight">{d.aralik}</p>
                  <p class={`text-xs font-black tracking-widest uppercase mt-0.5 ${d.tip === 'TATİL' ? 'text-muted' : 'text-accent'}`}>{d.tip}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- PROGRAM TAKVİMİ (timeline) -->
  <section class="py-16 md:py-20 bg-surface border-y border-border">
    <div class="max-w-5xl mx-auto px-6 md:px-8">
      <div class="reveal mb-10 text-center">
        <SectionHeader eyebrow="Program Takvimi" title="6 haftalık yol haritası" center />
      </div>
      <div class="reveal grid grid-cols-1 md:grid-cols-3 gap-4 items-stretch">
        {donemler.map(d => (
          <div class={`rounded-2xl p-6 text-center border ${
            d.tip === 'TATİL'
              ? 'bg-white border-dashed border-border'
              : 'bg-ink text-white border-ink'
          }`}>
            <p class="text-3xl mb-2" aria-hidden="true">{d.icon}</p>
            <p class={`text-sm font-bold mb-2 ${d.tip === 'TATİL' ? 'text-ink' : 'text-white'}`}>{d.aralik}</p>
            <span class={`inline-block text-xs font-black tracking-widest uppercase px-3 py-1 rounded-full ${
              d.tip === 'TATİL' ? 'bg-surface text-muted' : 'bg-accent text-white'
            }`}>{d.tip}</span>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- HAFTALIK PLAN + SINAV TAKVİMİ -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="grid lg:grid-cols-2 gap-8 items-start">

        <!-- Haftalık plan -->
        <div class="reveal">
          <SectionHeader eyebrow="Haftalık Plan" title="Haftada 4 gün" />
          <div class="mt-6 rounded-3xl border border-border overflow-hidden">
            <div class="grid grid-cols-4 bg-ink text-white">
              {gunler.map(g => (
                <div class="px-2 py-3.5 text-center text-xs font-bold tracking-wide">{g}</div>
              ))}
            </div>
            <div class="divide-y divide-border">
              <div class="flex items-center gap-4 px-5 py-4 bg-surface">
                <span class="inline-flex items-center justify-center rounded-lg bg-accent text-white text-xs font-black px-3 py-1.5 shrink-0 tabular-nums">10:00 – 15:40</span>
                <span class="font-bold text-ink">Ders <span class="font-medium text-muted">(Konu Anlatımı)</span></span>
              </div>
              <div class="flex items-center gap-4 px-5 py-4">
                <span class="inline-flex items-center justify-center rounded-lg bg-ink text-white text-xs font-black px-3 py-1.5 shrink-0 tabular-nums">15:50 – 17:20</span>
                <span class="font-bold text-ink">Soru Çözüm</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Sınav takvimi -->
        <div class="reveal" style="transition-delay:100ms">
          <SectionHeader eyebrow="Sınav Takvimi" title="Düzenli ölçme" />
          <ul class="mt-6 space-y-3">
            {sinavlar.map(s => (
              <li class="flex items-center gap-5 rounded-2xl border border-border bg-surface px-5 py-4">
                <div class="flex flex-col items-center justify-center w-16 h-16 rounded-xl bg-accent text-white shrink-0">
                  <span class="text-2xl font-black leading-none">{s.gun}</span>
                  <span class="text-[10px] font-bold tracking-wide uppercase mt-0.5">{s.ay}</span>
                </div>
                <div class="flex-1">
                  <p class="font-bold text-ink leading-tight">{s.ad}</p>
                  <p class="text-sm font-semibold text-accent mt-1 inline-flex items-center gap-1.5">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12,7 12,12 16,14"/></svg>
                    {s.saat}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- DEĞERLER -->
  <section class="py-14 md:py-16 bg-surface border-y border-border">
    <div class="max-w-5xl mx-auto px-6 md:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {degerler.map(d => (
          <div class="reveal flex flex-col items-center text-center gap-2 rounded-2xl bg-white border border-border p-5">
            <span class="text-2xl" aria-hidden="true">{d.emoji}</span>
            <span class="text-sm font-bold text-ink leading-tight">{d.ad}</span>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- KAPANIŞ CTA -->
  <section class="bg-ink text-white py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 50% 100%, rgba(155,0,48,0.28) 0%, transparent 60%);">
    </div>
    <div class="relative max-w-3xl mx-auto px-6 md:px-8 text-center flex flex-col items-center gap-6">
      <span class="text-xs font-bold tracking-widest text-accent uppercase">Kontenjan Sınırlı · Ön Kayıt</span>
      <h2 class="text-3xl md:text-5xl font-bold leading-tight" style="letter-spacing:-0.03em">
        TYT'de hedefin<br />zirve olsun!
      </h2>
      <p class="text-base md:text-lg text-white/60 leading-relaxed max-w-xl">
        TYT Master Yaz Programı 29 Haziran'da Efeler ve Nazilli şubelerimizde başlıyor.
        Bilgi ve ön kayıt için WhatsApp'tan yazın ya da telefonla ulaşın.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-3 mt-2">
        <WhatsAppButton ctx="tyt-master" label="WhatsApp'tan Ön Kayıt" class="text-base px-8 py-4" />
        <a href={TEL_HREF}
          class="inline-flex items-center gap-2.5 border border-white/25 hover:border-white/50 hover:bg-white/5 text-white font-semibold px-8 py-4 rounded-full transition-colors text-base">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.68 2.34a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.74-1.25a2 2 0 0 1 2.11-.45c.74.32 1.53.55 2.34.68A2 2 0 0 1 22 16.92z"/>
          </svg>
          {TEL_DISPLAY}
        </a>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1 text-sm text-white/50 mt-2">
        <span class="inline-flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          KNT Akademi Efeler
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          KNT Akademi Nazilli
        </span>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base
  title="Duyurular — TYT Master Maarif 2027 Çok Yakında | KNT Akademi"
  description="TYT Master Maarif 2027 çok yakında KNT Akademi'de."
>
  <section class="min-h-[80vh] pt-40 pb-24 bg-ink text-white relative overflow-hidden flex items-center">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(ellipse at 15% 0%, rgba(155,0,48,0.32) 0%, transparent 55%), radial-gradient(ellipse at 85% 100%, rgba(56,189,248,0.12) 0%, transparent 50%);">
    </div>
    <div class="relative max-w-4xl mx-auto px-6 md:px-8 text-center">
      <span class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-accent uppercase mb-6">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        Duyurular
      </span>
      <h1 class="text-5xl md:text-7xl font-black leading-none mb-6" style="letter-spacing:-0.03em">
        TYT MASTER<br /><span class="text-accent">MAARİF 2027</span>
      </h1>
      <p class="text-2xl md:text-4xl font-black tracking-widest text-white/80">ÇOK YAKINDA</p>
    </div>
  </section>
</Base>

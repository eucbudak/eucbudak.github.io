---
import Base from '../layouts/Base.astro';
import CTABand from '../components/CTABand.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Base
  title="Q Work — KNT Akademi"
  description="KNT Akademi'nin premium çalışma alanı ve kütüphanesi. Verimli çalışma alışkanlığı kuran bir ortam."
>
  <section class="pt-32 pb-24">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="max-w-2xl mb-16">
        <a href="/" class="text-xs text-muted hover:text-ink transition-colors mb-6 inline-flex items-center gap-1">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12,19 5,12 12,5"/></svg>
          Ana Sayfa
        </a>
        <span class="text-xs font-bold tracking-widest text-accent uppercase mb-6 block">Eğitim Çözümlerimiz</span>
        <h1 class="text-5xl md:text-6xl font-black text-ink mb-4" style="letter-spacing:-0.03em">Q Work</h1>
        <p class="text-xl font-medium text-muted mb-4">Çalışma alanı & kütüphane</p>
        <p class="text-base text-muted leading-relaxed">
          Sadece bir masa değil — çalışma alışkanlığı kuran bir ortam. Q Work, KNT Akademi öğrencilerine ders saatlerinin ötesinde, odaklanılmış bir çalışma alanı sunuyor.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-16">
        {[
          { icon: '📚', title: 'Geniş Kütüphane',     desc: 'TYT ve AYT için tüm yayınlar mevcuttur. İstediğin kaynağa anında ulaş.' },
          { icon: '🔇', title: 'Sessiz Çalışma Odaları', desc: 'Konsantre çalışma için özel bölümler. Telefon ve gürültüden uzak odaklanma.' },
          { icon: '☕', title: 'Konforlu Ortam',       desc: 'Uzun saatler çalışmaya uygun ergonomik mobilya ve ikram imkânı.' },
        ].map(item => (
          <div class="bg-surface rounded-2xl border border-border p-8 flex flex-col gap-4">
            <span class="text-3xl" aria-hidden="true">{item.icon}</span>
            <h3 class="font-bold text-ink">{item.title}</h3>
            <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="bg-ink rounded-2xl p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div>
          <p class="text-white font-bold text-xl mb-2">Q Work hakkında bilgi al</p>
          <p class="text-white/50 text-sm">Üyelik koşulları ve ücretler için bize ulaş.</p>
        </div>
        <WhatsAppButton ctx="general" label="WhatsApp'tan Sor" class="shrink-0" />
      </div>
    </div>
  </section>

  <CTABand
    title="Çalışma alanın hazır."
    sub="Q Work üyeliği için WhatsApp'tan iletişime geç."
    label="Bilgi Al"
  />
</Base>

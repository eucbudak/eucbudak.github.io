---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Compare from '../components/Compare.astro';
import CTABand from '../components/CTABand.astro';
---

<Base
  title="FOCUS Modeli — KNT Akademi"
  description="KNT Akademi'nin FOCUS modelini ve klasik dershaneden farkını öğren. Zaman optimizasyonu, bireysel koçluk ve Q Deneme Kulübü."
>
  <!-- Hero -->
  <section class="pt-32 pb-20">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold tracking-widest text-accent uppercase mb-6 block">Yaklaşımımız</span>
        <h1 class="text-5xl md:text-6xl font-black text-ink leading-tight mb-6" style="letter-spacing:-0.03em">
          Dershanelerin modeli<br />20 yıldır değişmedi.
        </h1>
        <p class="text-lg text-muted leading-relaxed">
          Herkese aynı ders, aynı yayın, aynı tempo. KNT Akademi bu modele direkt karşı bir sistem kurdu.
        </p>
      </div>
    </div>
  </section>

  <!-- FOCUS Modeli -->
  <section class="py-20 bg-surface border-y border-border">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <SectionHeader
            eyebrow="FOCUS Modeli"
            title="Gereksiz ders yok."
            sub="Sadece eksik olduğun konulara vakit harcarsın. Güçlü olduğun yerlerde hızlı geçiş, zayıf olduğun yerlerde derinlemesine çalışma."
          />
          <div class="mt-8 flex flex-col gap-5">
            {[
              { step: '01', title: 'Seviye tespiti', desc: 'Başlarken hangi konuların güçlü, hangilerinin zayıf olduğunu belirleriz.' },
              { step: '02', title: 'Kişisel ders planı', desc: 'Sadece ihtiyaç duyulan konular programa girer. Zaman kaybı yok.' },
              { step: '03', title: 'Sürekli güncelleme', desc: 'Deneme analizlerine göre plan her hafta koçlukla güncellenir.' },
            ].map(item => (
              <div class="flex gap-5">
                <span class="text-2xl font-black text-accent/20 shrink-0">{item.step}</span>
                <div>
                  <p class="font-bold text-ink mb-1">{item.title}</p>
                  <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal" style="transition-delay:80ms">
          <div class="bg-white rounded-2xl border border-border p-8 flex flex-col gap-6">
            <p class="text-xs font-bold tracking-widest text-muted uppercase">Sonuç</p>
            <blockquote class="text-2xl font-bold text-ink leading-tight" style="letter-spacing:-0.02em">
              "Zamandan kazanmak, daha fazla ders anlamına gelmiyor. Daha doğru ders anlamına geliyor."
            </blockquote>
            <p class="text-sm text-muted">
              FOCUS modelinde öğrenci ortalama %30 daha az ders saatiyle, %100 ihtiyaç odaklı bir program alıyor.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TYT Master -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="reveal">
        <SectionHeader
          eyebrow="TYT Master & Erken Başlama"
          title="Zaman avantajı gerçek bir avantaj."
          sub="Erken başlayan öğrenci daha fazla deneme çözmüyor — daha akıllı planlama yapıyor. TYT'yi erken bitir, AYT'ye odaklan."
        />
      </div>
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        {[
          { num: '3×', label: 'Daha fazla gözden geçirme', desc: 'Erken başlayan, aynı konuya üç kez dönebilir.' },
          { num: '↑',  label: 'Net artışı kalıcı olur',    desc: 'Tekrar döngüsü olmadan net artışı kalıcılaştırmak zor.' },
          { num: '0',  label: 'Sınav paniği',              desc: 'Süre baskısı olmadan yapılan hazırlık sınav koşullarına taşınır.' },
        ].map(item => (
          <div class="reveal bg-surface rounded-2xl border border-border p-8">
            <p class="text-5xl font-black text-accent mb-3">{item.num}</p>
            <p class="font-bold text-ink mb-2">{item.label}</p>
            <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Q Deneme Kulübü -->
  <section class="py-24 bg-surface border-y border-border">
    <div class="max-w-6xl mx-auto px-6 md:px-8">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <SectionHeader
            eyebrow="Q Deneme Kulübü"
            title="Yayını sen seçiyorsun."
            sub="Klasik sistemde kurum hangi yayını seçerse o yayını çözersin. KNT Akademi'de sana en uygun yayını birlikte belirleriz ve o yayınla ilerleriz."
          />
          <ul class="mt-8 flex flex-col gap-4">
            {[
              'Binlerce öğrencinin çözdüğü yayında kaybolma',
              'Kendi tempona ve stiline uygun yayın seç',
              'Analiz ve koçluk yayın seçiminden bağımsız devam eder',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-muted">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="2,8 6,12 14,4"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Comparison table -->
        <div class="reveal" style="transition-delay:80ms">
          <Compare />
        </div>
      </div>
    </div>
  </section>

  <CTABand
    title="Bu modelde çalışmak istiyorsan"
    sub="Sana en uygun paketi birlikte belirleyelim."
    ctx="focus"
    label="WhatsApp'tan Başvur"
  />
</Base>

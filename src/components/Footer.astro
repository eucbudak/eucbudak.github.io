---
import { wa } from '../lib/whatsapp';
---

<footer class="bg-ink text-white">
  <div class="max-w-6xl mx-auto px-6 md:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <img src="/logo.png" alt="KNT Akademi" class="h-8 w-auto mb-4 brightness-0 invert"
          onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
        <span style="display:none" class="block font-black text-xl text-white mb-4">KNT AKADEMİ</span>
        <p class="text-sm text-white/50 leading-relaxed max-w-xs">
          Kişiselleştirilmiş YKS hazırlık sistemi. Zamanını optimize et, hedefine odaklan.
        </p>
      </div>

      <!-- Links -->
      <div>
        <p class="text-xs font-semibold tracking-widest text-white/30 uppercase mb-5">Programlar</p>
        <ul class="space-y-3">
          <li><a href="/paketler/q-vip" class="text-sm text-white/60 hover:text-white transition-colors">Q VIP</a></li>
          <li><a href="/paketler/ozel-ders-basari-kulubu" class="text-sm text-white/60 hover:text-white transition-colors">Özel Ders Başarı Kulübü</a></li>
          <li><a href="/paketler/calisanlar-kulubu" class="text-sm text-white/60 hover:text-white transition-colors">Çalışanlar Kulübü</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-xs font-semibold tracking-widest text-white/30 uppercase mb-5">İletişim</p>
        <ul class="space-y-3">
          <li>
            <a
              href={wa('iletisim')}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-white/60 hover:text-white transition-colors flex items-center gap-2"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              0532 131 44 09
            </a>
          </li>
          <li><a href="/iletisim" class="text-sm text-white/60 hover:text-white transition-colors">İletişim & Konum</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/30">© {new Date().getFullYear()} KNT Akademi. Tüm hakları saklıdır.</p>
      <a href="/yaklasim" class="text-xs text-white/30 hover:text-white/60 transition-colors">FOCUS Modeli</a>
    </div>
  </div>
</footer>

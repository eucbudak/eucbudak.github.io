---
export interface Props {
  eyebrow?: string;
  title:    string;
  sub?:     string;
  center?:  boolean;
}
const { eyebrow, title, sub, center = false } = Astro.props;
const align = center ? 'text-center items-center' : '';
---

<div class={`flex flex-col gap-3 ${align}`}>
  {eyebrow && (
    <span class="text-xs font-semibold tracking-widest text-accent uppercase">{eyebrow}</span>
  )}
  <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-ink leading-tight" style="letter-spacing:-0.02em">
    {title}
  </h2>
  {sub && (
    <p class="text-base md:text-lg text-muted leading-relaxed max-w-xl">{sub}</p>
  )}
</div>

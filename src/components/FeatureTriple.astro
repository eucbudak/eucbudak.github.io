---
export interface FeatureItem {
  icon:  string;
  title: string;
  desc:  string;
}
export interface Props {
  items: FeatureItem[];
}
const { items } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {items.map(item => (
    <div class="flex flex-col gap-4 p-8 bg-white rounded-2xl border border-border">
      <div class="w-10 h-10 rounded-xl bg-accent-soft flex items-center justify-center text-xl" aria-hidden="true">
        {item.icon}
      </div>
      <h3 class="text-lg font-bold text-ink tracking-tight">{item.title}</h3>
      <p class="text-sm text-muted leading-relaxed">{item.desc}</p>
    </div>
  ))}
</div>

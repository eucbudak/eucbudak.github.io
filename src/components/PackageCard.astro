---
import { type Pkg } from '../data/packages';
import { wa } from '../lib/whatsapp';

export interface Props {
  pkg:       Pkg;
  featured?: boolean;
}

const { pkg, featured = false } = Astro.props;
const waUrl = wa(pkg.waCtx);
---

<article class={`relative flex flex-col rounded-2xl border p-8 transition-shadow duration-200 hover:shadow-lg ${featured ? 'bg-ink text-white border-ink' : 'bg-white text-ink border-border'}`}>

  {pkg.badge && (
    <span class={`absolute top-6 right-6 text-xs font-bold px-3 py-1 rounded-full ${featured ? 'bg-accent text-white' : 'bg-accent-soft text-accent'}`}>
      {pkg.badge}
    </span>
  )}

  <div class="mb-6">
    <h3 class={`text-2xl font-bold tracking-tight mb-1 ${featured ? 'text-white' : 'text-ink'}`} style="letter-spacing:-0.02em">
      {pkg.name}
    </h3>
    <p class={`text-sm font-medium ${featured ? 'text-white/60' : 'text-muted'}`}>{pkg.tagline}</p>
  </div>

  <p class={`text-sm leading-relaxed mb-6 ${featured ? 'text-white/70' : 'text-muted'}`}>{pkg.forWho}</p>

  <ul class="flex flex-col gap-3 mb-8 flex-1">
    {pkg.features.map(f => (
      <li class="flex items-start gap-3 text-sm">
        <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="2,8 6,12 14,4"/>
        </svg>
        <span class={featured ? 'text-white/80' : 'text-ink/80'}>{f}</span>
      </li>
    ))}
  </ul>

  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`flex items-center justify-center gap-2 font-semibold text-sm py-3 px-6 rounded-full transition-colors duration-150 ${
      featured
        ? 'bg-accent hover:bg-accent-hover text-white'
        : 'border border-accent text-accent hover:bg-accent-soft'
    }`}
  >
    Bilgi Al
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/>
    </svg>
  </a>
</article>
